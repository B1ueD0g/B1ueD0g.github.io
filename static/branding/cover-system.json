{
  "schema_version": 1,
  "canvas": {
    "width": 1200,
    "height": 630,
    "safe_margin": 72
  },
  "palette": {
    "paper": "#f4f4f2",
    "ink": "#11151c",
    "accent": "#315c78",
    "muted": "#56616a",
    "rule": "#c9cecf",
    "tint": "#e8edef"
  },
  "fonts": {
    "latin": "Arial",
    "cjk": "PingFang SC",
    "canva_cjk_alternative": "Noto Sans SC",
    "title_weight": 600,
    "ui_weight": 400,
    "label_weight": 700
  },
  "templates": [
    {
      "id": "analysis",
      "file": "cover-analysis.svg",
      "label": "ORIGINAL ANALYSIS",
      "motif": "trust boundary and evidence nodes",
      "content_types": [
        "original analysis",
        "research methods"
      ]
    },
    {
      "id": "guide",
      "file": "cover-guide.svg",
      "label": "FIELD GUIDE",
      "motif": "three connected steps",
      "content_types": [
        "field guide",
        "deployment",
        "tutorial"
      ]
    },
    {
      "id": "reading",
      "file": "cover-reading.svg",
      "label": "READING & TRANSLATION",
      "motif": "source pages and marginal note",
      "content_types": [
        "reading note",
        "translation"
      ],
      "published_labels": [
        "READING NOTE",
        "TRANSLATION"
      ]
    }
  ],
  "layout": {
    "header_rule_y": 122,
    "category": {
      "x": 72,
      "baseline_y": 172,
      "size": 21
    },
    "date": {
      "right": 1128,
      "baseline_y": 172,
      "size": 21,
      "format": "YYYY.MM.DD",
      "missing": "ARCHIVE"
    },
    "title": {
      "x": 72,
      "illustrated_width": 700,
      "text_only_width": 1056,
      "maximum_lines": 3,
      "preferred_size": 64,
      "minimum_illustrated_size": 54,
      "minimum_text_only_size": 36,
      "line_height": 1.3,
      "no_ellipsis": true,
      "overflow_behavior": "remove illustration, then fit complete text; fail rather than truncate"
    },
    "motif": {
      "x": 804,
      "y": 168,
      "width": 336,
      "height": 340,
      "canvas_fraction": 0.1511
    },
    "footer_rule_y": 522,
    "footer": {
      "baseline_y": 572,
      "author": "BlueDog",
      "domain": "bluedog.website",
      "id": "ARCHIVE / first 6 uppercase hex characters of the article title MD5; MD5 is an asset identity, not a security signature"
    }
  },
  "editing_notes": [
    "Replace placeholders with verified article metadata. Never invent dates, achievement claims or research results.",
    "Keep title text editable as one text object per line. Artwork uses native SVG geometry; no embedded raster.",
    "Motifs are editorial topic cues and do not assert measured scientific causation or results.",
    "Reading and translation share one master but retain distinct published labels.",
    "Long titles use the full text width and omit the motif before reducing type. Never crop or ellipsize Chinese titles.",
    "Preserve existing article-specific cover images; these masters supply generated fallbacks only.",
    "Old article-cover-template.svg is a compatible copy of cover-analysis.svg."
  ],
  "topic_variants": {
    "analysis": [
      "trust boundary",
      "topology / AI node graph",
      "research evidence chain",
      "cloud layers"
    ],
    "guide": [
      "connected steps"
    ],
    "reading": [
      "annotated source pages"
    ]
  },
  "runtime": {
    "command": "python3 scripts/generate_og_cards.py",
    "python_packages": [
      "Pillow",
      "PyYAML"
    ],
    "linux_font_package": "fonts-noto-cjk",
    "failure_policy": "Fail if no CJK-capable font is available; no Latin-only fallback."
  }
}
